# ===========================================================================
#  OdontSmart - Variables de entorno (copiar a .env y completar)
#  En desarrollo los valores por defecto de settings.py ya funcionan.
# ===========================================================================

# Clave secreta de Django (obligatoria en producción: generar una aleatoria)
DJANGO_SECRET_KEY=change-me-por-una-clave-aleatoria-larga

# Debug: 1/true en desarrollo, 0/false en producción
DJANGO_DEBUG=True

# Hosts permitidos separados por coma (p.ej. clinica1.odontsmart.com,www...)
DJANGO_ALLOWED_HOSTS=*
